{
  "hooks": {
    "PostToolUse": [{ "matcher": "Edit|Write|MultiEdit",
      "hooks": [{ "type": "command", "command": "uv run python \"${CLAUDE_PLUGIN_ROOT}/scripts/format.py\"" }] }],
    "PreToolUse": [{ "matcher": "Bash",
      "hooks": [{ "type": "command", "command": "uv run python \"${CLAUDE_PLUGIN_ROOT}/scripts/bash_guard.py\"" }] }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "uv run python \"${CLAUDE_PLUGIN_ROOT}/scripts/test_gate.py\"" }] }],
    "SessionStart": [{ "matcher": "compact",
      "hooks": [{ "type": "command", "command": "uv run python \"${CLAUDE_PLUGIN_ROOT}/scripts/restore_state.py\"" }] }]
  }
}